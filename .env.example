# Signaling (WebSocket + health). Put a TLS terminator in front for wss://.
SFU_BIND_HTTP=0.0.0.0:7898

# Media. ONE UDP port carries every room; open it in the firewall.
SFU_BIND_UDP=0.0.0.0:7899

# The address browsers are told to send media to. Required on a server:
# auto-detection finds the box's own interface, which is wrong behind NAT.
SFU_PUBLIC_IP=203.0.113.10

# HS256 key for join tokens. Must match whatever mints them.
SFU_SHARED_SECRET=change-me

# Optional: where room lifecycle events are POSTed. Unset = standalone.
SFU_WEBHOOK_URL=http://127.0.0.1:7896/api/webhooks/sfu
# Defaults to SFU_SHARED_SECRET when unset.
SFU_WEBHOOK_SECRET=

# ICE-lite is correct when the SFU has a routable public address and nothing
# in front of it. Leave off for local development.
SFU_ICE_LITE=false

SFU_MAX_ROOM_PEERS=16
RUST_LOG=ferrite_sfu=info,str0m=warn
